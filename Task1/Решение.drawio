        <mxCell id="jXlvdReL5OzZzgrPRtf2-87" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;resizable=1;resizeWidth=0;resizeHeight=0;gradientColor=#97d077;" value="Excel" vertex="1">
