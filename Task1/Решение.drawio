        <mxCell id="jXlvdReL5OzZzgrPRtf2-88" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=18;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;АБС — автоматизированная банковская система (Delphi/Oracle)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;ИБ — интернет-банк (ASP.NET MVC/MS SQL)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;СКЦ — система кол-центра банка (React/Java/PostgreSQL)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;ПКЦ — внешняя система партнёрского кол-центра&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;СМС — СМС-шлюз телеком-оператора&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;КК — кредитный конвейер (Camunda/Oracle)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;СК — система кредитного скоринга (Python/Flask/PostgreSQL)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;БКИ — бюро кредитных историй (REST API)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Сайт — PHP/React&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Excel/email — ручная передача ставок/согласований&lt;/p&gt;" vertex="1">
          <mxGeometry height="1130" width="420" x="1530" y="190" as="geometry" />
        </mxCell>
